using Gtk 4.0;
using Adw 1;

template $IgneousQuickSwitcher: Adw.Dialog {
  title: _("Find Note");
  content-width: 560;
  content-height: 480;

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      show-start-title-buttons: false;
      show-end-title-buttons: false;

      [title]
      SearchEntry search_entry {
        placeholder-text: _("Find or create a note");
        hexpand: true;
      }
    }

    content: Stack stack {
      StackPage {
        name: "results";

        child: ScrolledWindow {
          hscrollbar-policy: never;

          child: ListView results_view {
            single-click-activate: true;

            styles [
              "navigation-sidebar",
            ]
          };
        };
      }

      StackPage {
        name: "empty";

        child: Adw.StatusPage empty_page {
          icon-name: "edit-find-symbolic";
          title: _("No Matching Notes");

          styles [
            "compact",
          ]
        };
      }
    };

    [bottom]
    Label hint {
      label: _("Enter to open · Ctrl+Enter for a new tab · Shift+Enter to create");
      margin-top: 6;
      margin-bottom: 6;

      styles [
        "dim-label",
        "caption",
      ]
    }
  };
}
