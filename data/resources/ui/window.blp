using Gtk 4.0;
using Adw 1;

template $IgneousWindow: Adw.ApplicationWindow {
  default-width: 1100;
  default-height: 760;
  width-request: 360;
  height-request: 294;

  Adw.Breakpoint {
    condition ("max-width: 900sp")

    setters {
      inspector_split.collapsed: true;
    }
  }

  Adw.Breakpoint {
    condition ("max-width: 600sp")

    setters {
      split_view.collapsed: true;
      inspector_split.collapsed: true;
    }
  }

  content: Adw.ToastOverlay toast_overlay {
    child: Adw.OverlaySplitView split_view {
      min-sidebar-width: 220;
      max-sidebar-width: 340;

      sidebar: Adw.ToolbarView {
        [top]
        Adw.HeaderBar {
          [title]
          Adw.WindowTitle vault_title {}

          [start]
          Button {
            icon-name: "document-new-symbolic";
            tooltip-text: _("New Note");
            action-name: "win.new-note";
          }

          [end]
          Button {
            icon-name: "folder-new-symbolic";
            tooltip-text: _("New Folder");
            action-name: "win.new-folder";
          }
        }

        [top]
        Adw.InlineViewSwitcher sidebar_switcher {
          stack: sidebar_stack;
          display-mode: icons;
          margin-start: 12;
          margin-end: 12;
          margin-bottom: 6;

          styles [
            "flat",
          ]
        }

        content: Adw.ViewStack sidebar_stack {
          Adw.ViewStackPage {
            name: "files";
            title: _("Files");
            icon-name: "folder-symbolic";

            child: ScrolledWindow {
              hscrollbar-policy: never;

              child: ListView files_view {
                single-click-activate: true;
                tab-behavior: item;

                styles [
                  "navigation-sidebar",
                ]
              };
            };
          }

          Adw.ViewStackPage {
            name: "search";
            title: _("Search");
            icon-name: "edit-find-symbolic";

            child: Adw.Bin search_bin {};
          }

          Adw.ViewStackPage {
            name: "tags";
            title: _("Tags");
            icon-name: "tag-symbolic";

            child: Adw.Bin tags_bin {};
          }

          Adw.ViewStackPage changes_page {
            name: "changes";
            title: _("Changes");
            icon-name: "document-edit-symbolic";
            visible: false;

            child: Adw.Bin changes_bin {};
          }
        };
      };

      content: Adw.OverlaySplitView inspector_split {
        sidebar-position: end;
        show-sidebar: false;
        min-sidebar-width: 240;
        max-sidebar-width: 360;

        sidebar: Adw.Bin inspector_bin {};

        content: Adw.ToolbarView {
        [top]
        Adw.HeaderBar {
          [start]
          ToggleButton {
            icon-name: "sidebar-show-symbolic";
            tooltip-text: _("Toggle Sidebar");
            active: bind split_view.show-sidebar bidirectional;
          }

          [title]
          Adw.WindowTitle note_title {
            title: _("Igneous");
          }

          [end]
          MenuButton {
            primary: true;
            icon-name: "open-menu-symbolic";
            tooltip-text: _("Main Menu");
            menu-model: primary_menu;
          }

          [end]
          ToggleButton {
            icon-name: "sidebar-show-right-symbolic";
            tooltip-text: _("Toggle Inspector");
            active: bind inspector_split.show-sidebar bidirectional;
          }

          [end]
          Adw.Bin sync_slot {}

          [end]
          Adw.ToggleGroup mode_toggle {
            visible: false;
            active-name: "live";

            Adw.Toggle {
              name: "live";
              icon-name: "format-text-rich-symbolic";
              tooltip: _("Live Preview");
            }

            Adw.Toggle {
              name: "source";
              icon-name: "text-x-generic-symbolic";
              tooltip: _("Source");
            }

            Adw.Toggle {
              name: "reading";
              icon-name: "view-reveal-symbolic";
              tooltip: _("Reading");
            }

            styles [
              "flat",
            ]
          }
        }

        [top]
        Adw.Banner sync_banner {
          button-label: _("_Resolve");
          revealed: false;
        }

        [top]
        Adw.TabBar tab_bar {
          view: tab_view;
          autohide: false;
        }

        content: Stack content_stack {
          StackPage {
            name: "empty";

            child: Adw.StatusPage {
              icon-name: "dev.h4rl3y.igneous-symbolic";
              title: _("No Note Open");
              description: _("Pick a note in the sidebar, press Ctrl+O to find one, or Ctrl+N to start a new one");
            };
          }

          StackPage {
            name: "tabs";
            child: Adw.TabView tab_view {};
          }
        };
      };
      };
    };
  };
}

menu primary_menu {
  section {
    item {
      label: _("_New Note");
      action: "win.new-note";
    }

    item {
      label: _("New _Folder");
      action: "win.new-folder";
    }

    item {
      label: _("_Find Note…");
      action: "win.quick-switcher";
    }

    item {
      label: _("_Command Palette…");
      action: "win.command-palette";
    }

    item {
      label: _("_Graph View");
      action: "win.graph";
    }
  }

  section {
    item {
      label: _("_Sync Now");
      action: "win.sync-now";
      hidden-when: "action-disabled";
    }

    item {
      label: _("Note _History");
      action: "win.note-history";
      hidden-when: "action-disabled";
    }
  }

  section {
    item {
      label: _("_Open Vault…");
      action: "app.new-window";
    }
  }

  section {
    item {
      label: _("_Preferences");
      action: "win.preferences";
    }

    item {
      label: _("_Keyboard Shortcuts");
      action: "app.shortcuts";
    }

    item {
      label: _("_About Igneous");
      action: "app.about";
    }
  }
}
