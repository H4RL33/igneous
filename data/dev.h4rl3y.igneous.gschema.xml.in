<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="igneous">
  <schema id="@APP_ID@" path="@SCHEMA_PATH@">
    <key name="window-width" type="i">
      <default>1100</default>
      <summary>Window width</summary>
    </key>
    <key name="window-height" type="i">
      <default>760</default>
      <summary>Window height</summary>
    </key>
    <key name="window-maximized" type="b">
      <default>false</default>
      <summary>Whether the window is maximized</summary>
    </key>
    <key name="recent-vaults" type="as">
      <default>[]</default>
      <summary>Recently opened vaults, most recent first</summary>
    </key>
    <key name="open-vaults" type="as">
      <default>[]</default>
      <summary>Vaults that were open when Igneous last quit</summary>
      <description>These are reopened when Igneous starts.</description>
    </key>
  </schema>
</schemalist>
