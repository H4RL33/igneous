[
  {
    "name": "Removes punctuation from the end of a heading",
    "before": "# Heading ends in a period.\n## Other heading ends in an exclamation mark! ##",
    "after": "# Heading ends in a period\n## Other heading ends in an exclamation mark ##",
    "source": "example"
  },
  {
    "name": "HTML Entities at the end of a heading is ignored",
    "before": "# Heading 1\n## Heading &amp;",
    "after": "# Heading 1\n## Heading &amp;",
    "source": "example"
  },
  {
    "name": "Removes punctuation from the end of a heading when followed by whitespace",
    "before": "# Heading 1!  \n## Heading 2.\t",
    "after": "# Heading 1  \n## Heading 2\t",
    "source": "example"
  },
  {
    "name": "Leaves trailing heading punctuation inside fenced code alone",
    "before": "```\n# inside!\n```\n# outside!",
    "after": "```\n# inside!\n```\n# outside",
    "source": "test"
  },
  {
    "name": "Leaves trailing heading punctuation inside disabled sections alone",
    "before": "<!-- linter-disable -->\n# inside!\n<!-- linter-enable -->\n# outside!",
    "after": "<!-- linter-disable -->\n# inside!\n<!-- linter-enable -->\n# outside",
    "source": "test"
  },
  {
    "name": "Preserves masking behavior across a multiline disabled section in a heading",
    "before": "# <!-- linter-disable -->\n<!-- linter-enable -->!",
    "after": "# <!-- linter-disable -->\n<!-- linter-enable -->",
    "source": "test"
  },
  {
    "name": "Maps punctuation edits around protected blocks in source order",
    "before": "# first!!\n```\n# inside!\n```\n# <!-- linter-disable -->\n<!-- linter-enable -->!!  ##\n# last!",
    "after": "# first\n```\n# inside!\n```\n# <!-- linter-disable -->\n<!-- linter-enable -->  ##\n# last",
    "source": "test"
  },
  {
    "name": "A single trailing punctuation character is removed",
    "before": "# Heading.",
    "after": "# Heading",
    "options": {
      "punctuationToRemove": ".,;:!。，；：！"
    },
    "source": "test"
  },
  {
    "name": "Several trailing punctuation characters are all removed in one pass",
    "before": "# Heading!!!",
    "after": "# Heading",
    "options": {
      "punctuationToRemove": ".,;:!。，；：！"
    },
    "source": "test"
  },
  {
    "name": "A mixture of trailing punctuation characters is removed in one pass",
    "before": "# Heading!?.,;",
    "after": "# Heading!?",
    "options": {
      "punctuationToRemove": ".,;:!。，；：！"
    },
    "source": "test"
  },
  {
    "name": "Running the rule again changes nothing",
    "before": "# Heading",
    "after": "# Heading",
    "options": {
      "punctuationToRemove": ".,;:!。，；：！"
    },
    "source": "test"
  },
  {
    "name": "Trailing whitespace after the punctuation is preserved",
    "before": "# Heading!!  ",
    "after": "# Heading  ",
    "options": {
      "punctuationToRemove": ".,;:!。，；：！"
    },
    "source": "test"
  },
  {
    "name": "Punctuation that is not configured for removal is left alone",
    "before": "# Heading???",
    "after": "# Heading???",
    "options": {
      "punctuationToRemove": ".,;:!。，；：！"
    },
    "source": "test"
  },
  {
    "name": "Full width punctuation is removed too",
    "before": "# 見出し！！",
    "after": "# 見出し",
    "options": {
      "punctuationToRemove": ".,;:!。，；：！"
    },
    "source": "test"
  },
  {
    "name": "A heading of nothing but punctuation is left with no text",
    "before": "# ...",
    "after": "# ",
    "options": {
      "punctuationToRemove": ".,;:!。，；：！"
    },
    "source": "test"
  }
