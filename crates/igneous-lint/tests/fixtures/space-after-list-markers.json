  {
    "name": "A single space is left between the list marker and the text of the list item",
    "before": "1.   Item 1\n2.  Item 2\n\n-   [ ] Item 1\n- [x]    Item 2\n\t-  [ ] Item 3",
    "after": "1. Item 1\n2. Item 2\n\n- [ ] Item 1\n- [x] Item 2\n\t- [ ] Item 3",
    "source": "example"
  },
  {
    "name": "Orders marker and checkbox edits together without duplicating empty items",
